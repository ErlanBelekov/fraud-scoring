{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": ".",
    "paths": { "@fraud/shared": ["../../packages/shared/src/index.ts"] },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*", "test/**/*", "../../packages/shared/src/**/*"]
}
